import java.util.Scanner;

public class EvenNumbers {
    public static void main(String[] args) {
        System.out.println("--- EVEN NUMBER FROM 2 TO 100 ---");

        for (int i = 2; i <= 100; i += 2) {
            System.out.print(i + " ");

            if (i % 20 == 0) {
                System.out.println();
            }
        }
    }     
}
