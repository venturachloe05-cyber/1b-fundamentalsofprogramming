import java.util.Scanner;

public class Dinero {
    public static void main(String[] args) {
        Scanner sc = new Scanner(System.in);
        double balance = 20000.00;

        System.out.println("Initial Balance: P" + balance);
        System.out.println("Enter numbers {Enter - to terminate):");

        while (true) {
            double input = sc.nextDouble();

            if (input == 0) {
                System.out.println("Program terminated/ Final Balance: P" + balance);
                break;
            }

            if (input > 0) {
                balance += input;
                System.out.println("Deposited: P" + input);
                System.out.println("Outstanding Balance: P" + balance);
            } else {
                double withdrawalAmount = Math.abs(input);

                if (withdrawalAmount > balance) {
                    System.out.println("INSUFFICIENT FUNDS!");
                    System.out.println("Outstanding Balance: P" + balance);
                } else {
                    balance -= withdrawalAmount;
                    System.out.println("Withdrawn:P" + withdrawalAmount);
                    System.out.println("Outstanding Balance: P" + balance);
                }
            }
            System.out.println("-------------------");
        }
    }
}


